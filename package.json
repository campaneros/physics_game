{
  "name": "acceleratore",
  "version": "1.0.0",
  "private": true,
  "description": "Acceleratore: idle game di fisica con minigioco La forma nascosta",
  "scripts": {
    "check": "node check.js && node check-game.js && node check-budget.js && node check-i18n.js",
